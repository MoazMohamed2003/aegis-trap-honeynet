# Copy this file to .env (or /etc/aegis-bridge.env for systemd) and fill in real values.
# NEVER commit the real file.

# --- Required ---
TAXII_USER=your_taxii_username
TAXII_PASSWORD=your_taxii_password

# --- Optional (defaults shown) ---
# TAXII collection "objects" endpoint, through the Nginx gate on port 8080
TAXII_URL=http://localhost:8080/taxii2/<api-root-id>/collections/<collection-id>/objects/

# Path to the GCP service account key (keep it OUTSIDE the repository)
GCP_CREDS_FILE=/opt/aegis-bridge/gcp-key.json
